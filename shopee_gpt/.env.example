# Local personal studio. Never expose this server directly to the internet.
# Optional: verified product API
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Gemini scripts, Gemini 3.8 Flash TTS and stored cloned voices use this same key.
# Without a key, scripts use a labeled editable template; Edge TTS remains available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# TTS uses the exact gemini-3.8-flash-tts model. Stored voice_ IDs use this key's Google project.
# Voice: install requirements.txt and set the Python executable if needed.
PYTHON_PATH=python
# Optional absolute paths; default auto-discovery for Codex, FFmpeg and FFprobe.
CODEX_CLI=
FFMPEG_PATH=
FFPROBE_PATH=
# Durable local files. Use an absolute path to put them on another drive.
STUDIO_DATA_DIR=
# Optional bearer token for trusted server-to-server API callers. Browser UI uses same-origin requests.
STUDIO_API_TOKEN=
